:80 {
	encode gzip

	handle_path /static/* {
		root * /app/cacao_accounting/static
		file_server
		header Cache-Control "public, max-age=86400"
		header -Server
	}

	# Caddy ya envía X-Forwarded-For/Proto/Host por defecto; declararlos
	# provocaba advertencias y sustituía la cadena de proxies por el host
	# remoto. Se conserva el comportamiento por defecto.
	reverse_proxy localhost:8080
}
